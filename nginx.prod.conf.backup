# GL-CRIT-0026: NGINX configuration for HTTPS/TLS termination
# GO-LIVE-078: Configuration template with environment variable substitution
# Production reverse proxy with SSL certificate management
#
# Environment variables:
#   SSL_DOMAIN        - Domain for SSL certificates (e.g., 34.14.220.171.nip.io)
#   SERVER_NAMES      - Space-separated list of server names (default: SSL_DOMAIN)
#   API_RATE_LIMIT    - API rate limit per minute (default: 30)
#   AUTH_RATE_LIMIT   - Auth rate limit per minute (default: 5)

# Upstream backend API
# Using supermandi-api-gateway (Docker container name)
upstream api_gateway {
    server supermandi-api-gateway:3000;
    keepalive 32;
}

# Upstream retailer portal frontend
# GO-LIVE-B9: Retailer portal at /retailer/
upstream retailer_portal {
    server retailer-admin:80;
    keepalive 8;
}

# Upstream supplier portal frontend
# GO-LIVE-B9: Supplier portal at /supplier/
upstream supplier_portal {
    server supplier-portal:3001;
    keepalive 8;
}

# Rate limiting zones
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;

# HTTP -> HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name supermandi.tech 34.14.220.171.nip.io api.supermandi.com _;

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Health check on HTTP (for Docker healthcheck)
    location = /health {
        proxy_pass http://api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
    }

    # PORTAL-ROUTING-002: Retailer Portal at /retailer/ (SPA static files)
    # Serves static files with try_files for SPA client-side routing
    location /retailer {
        alias /var/www/retailer-admin;
        index index.html;
        try_files $uri $uri/ /retailer/index.html;
    }

    # PORTAL-ROUTING-002: Cache retailer static assets (hashed filenames)
    location ~* ^/retailer/assets/.*\.(js|css)$ {
        root /var/www;
        rewrite ^/retailer/(.*)$ /retailer-admin/$1 break;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # GO-LIVE-B9: Super Admin Portal at /admin/ (static files)
    location /admin {
        alias /var/www/admin;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }
    location = /admin/index.html {
        alias /var/www/admin/index.html;
    }

    # GO-LIVE-B9: Supplier Portal at /supplier/
    location /supplier/ {
        proxy_pass http://supplier_portal;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # GO-LIVE-B9: API endpoints on HTTP for portal testing
    location /api/ {
        proxy_pass http://api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # GO-LIVE-HOME-001: Serve landing page portal selector at root
    location = / {
        root /var/www/supermandi-landing;
        index index.html;
        try_files /index.html =404;
        add_header Cache-Control "no-store";
    }

    # Redirect all other traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name supermandi.tech 34.14.220.171.nip.io api.supermandi.com _;

    # SSL certificates (Let's Encrypt) - GO-LIVE-078: Configurable path
    ssl_certificate /etc/letsencrypt/live/supermandi.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/supermandi.tech/privkey.pem;

    # SSL security settings
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    # Modern SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # HSTS
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Security headers
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy "strict-origin-when-cross-origin";
    # GO-LIVE-110: Content Security Policy to mitigate XSS attacks
    # Note: 'unsafe-inline' needed for React inline styles, 'unsafe-eval' for some build tools
    # This significantly reduces XSS risk even with localStorage token storage
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';";

    # Request size limits
    client_max_body_size 10M;

    # Timeouts
    proxy_connect_timeout 30s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # Health check (no rate limit)
    location = /health {
        proxy_pass http://api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Auth endpoints (stricter rate limit)
    location ~ ^/(auth|api/v1/auth)/ {
        limit_req zone=auth_limit burst=10 nodelay;

        proxy_pass http://api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # PORTAL-ROUTING-002: Retailer Portal at /retailer/ (SPA static files)
    # Serves static files with try_files for SPA client-side routing
    location /retailer {
        alias /var/www/retailer-admin;
        index index.html;
        try_files $uri $uri/ /retailer/index.html;
    }

    # PORTAL-ROUTING-002: Cache retailer static assets (hashed filenames)
    location ~* ^/retailer/assets/.*\.(js|css)$ {
        root /var/www;
        rewrite ^/retailer/(.*)$ /retailer-admin/$1 break;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # GO-LIVE-B9: Super Admin Portal at /admin/ (static files)
    location /admin {
        alias /var/www/admin;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }
    location = /admin/index.html {
        alias /var/www/admin/index.html;
    }

    # GO-LIVE-B9: Supplier Portal at /supplier/
    location /supplier/ {
        proxy_pass http://supplier_portal;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # GO-LIVE-HOME-001: Serve landing page portal selector at root
    location = / {
        root /var/www/supermandi-landing;
        index index.html;
        try_files /index.html =404;
        add_header Cache-Control "no-store";
    }

    # API endpoints
    location /api/ {
        limit_req zone=api_limit burst=50 nodelay;

        proxy_pass http://api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # All other paths (auth routes, webhooks, etc.)
    location / {
        limit_req zone=api_limit burst=50 nodelay;

        proxy_pass http://api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Error pages
    error_page 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
        internal;
    }
}
