            "ready_for_operator_test",
            "ready_for_lock",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-008",
          "risk": "external_integration_not_contract_validated",
          "detection": "ticket.externalIntegrations.touched == true AND ticket.externalIntegrations.allValidated == false",
          "block": [
            "ready_for_operator_test",
            "ready_for_lock",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-009",
          "risk": "wrong_surface_build_or_url_mapping",
          "detection": "ticket.buildMapping.urlMappingValidated == false OR ticket.buildMapping.correctBuildTargetValidated == false",
          "block": [
            "ready_for_operator_test",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-010",
          "risk": "pending_dependencies_not_disclosed",
          "detection": "ticket.dependencyDisclosure.pendingDependencies.length > 0 OR ticket.dependencyDisclosure.disclosedToOperator == false",
          "block": [
            "ready_for_operator_test",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-011",
          "risk": "coding_not_done_in_cloud_workspace",
          "detection": "ticket.claudeChecks.cloudWorkspaceValidated == false",
          "block": [
            "ready_for_operator_test",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-012",
          "risk": "git_discipline_missing_or_mixed_changes",
          "detection": "ticket.gitDiscipline.noMixedScope == false OR ticket.gitDiscipline.noConflictMarkers == false",
          "block": [
            "ready_for_operator_test",
            "staging_deploy",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-013",
          "risk": "missing_session_bootstrap_or_required_file_read",
          "detection": "ticket.sessionBoot.requiredFilesRead missing required workflow files OR ticket.sessionBoot.bootstrappedBy != claude",
          "block": [
            "ready_for_operator_test",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-014",
          "risk": "production_invariants_not_verified",
          "detection": "any required productionInvariants status != pass OR any productionInvariants status == fail/pending at ready status",
          "block": [
            "ready_for_operator_test",
            "ready_for_lock",
            "lock_ticket",
            "certify_screen"
          ]
        }
      ],
      "operator": [
        {
          "id": "OP-001",
