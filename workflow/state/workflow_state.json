    "ticketRules": {
      "maxActiveTicketsPerScreen": 1,
      "maxWipTicketsGlobal": 1,
      "maxWipScreensGlobal": 1,
      "enforceTopLevelOrder": true,
      "maxSubTicketsPerParent": 10,
      "blockSubTicketStartIfParentNotActive": true,
      "requiredLayerChecklist": [
        "ui",
        "ux",
        "professional_polish",
        "wiring",
        "navigation",
        "api",
        "backend",
        "db",
        "migration",
        "gcp_parity"
      ],
      "lockRequires": [
        "all_layer_checks_not_fail",
        "operator_final_signoff",
        "impact_retest_passed_or_na",
        "staging_parity_evidence_attached"
      ]
    },
    "failureModeRules": {
      "claude": [
        {
          "id": "CL-001",
          "risk": "coding_without_operator_screen_visualization",
          "detection": "ticket.claudeChecks.screenVisualizedWithOperator == false",
          "block": [
            "ready_for_operator_test",
            "staging_deploy"
          ]
        },
        {
          "id": "CL-002",
          "risk": "claim_fix_without_staging_deploy_evidence",
          "detection": "ticket.claudeChecks.stagingDeployPassed == false",
          "block": [
            "ready_for_operator_test",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-003",
          "risk": "missing_env_basepath_contract_checks",
          "detection": "ticket.claudeChecks.envAndBasePathChecked == false OR ticket.claudeChecks.apiContractChecked == false",
          "block": [
            "ready_for_operator_test"
          ]
        },
        {
          "id": "CL-004",
          "risk": "unsafe_db_or_migration_change",
          "detection": "ticket.layers.migration == pass AND ticket.claudeChecks.migrationSafetyChecked == false",
          "block": [
            "ready_for_operator_test",
            "lock_ticket",
            "enter_freeze"
          ]
        },
        {
          "id": "CL-005",
          "risk": "lock_ticket_with_open_regression_impact",
          "detection": "ticket.impact.impactRetestRequired == true AND ticket.impact.impactRetestStatus != passed",
          "block": [
            "lock_ticket",
            "certify_screen"
          ]
        },
        {
          "id": "CL-006",
          "risk": "no_rollback_plan_for_ticket",
          "detection": "ticket.claudeChecks.rollbackPlanReady == false",
          "block": [
            "ready_for_operator_test",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-007",
          "risk": "hidden_mock_data_or_mock_api_usage",
          "detection": "ticket.truthDeclaration.mockDataUsed == true OR ticket.truthDeclaration.mockApisUsed == true",
          "block": [
            "ready_for_operator_test",
            "ready_for_lock",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-008",
          "risk": "external_integration_not_contract_validated",
          "detection": "ticket.externalIntegrations.touched == true AND ticket.externalIntegrations.allValidated == false",
          "block": [
            "ready_for_operator_test",
            "ready_for_lock",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-009",
          "risk": "wrong_surface_build_or_url_mapping",
          "detection": "ticket.buildMapping.urlMappingValidated == false OR ticket.buildMapping.correctBuildTargetValidated == false",
          "block": [
            "ready_for_operator_test",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-010",
          "risk": "pending_dependencies_not_disclosed",
          "detection": "ticket.dependencyDisclosure.pendingDependencies.length > 0 OR ticket.dependencyDisclosure.disclosedToOperator == false",
          "block": [
            "ready_for_operator_test",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-011",
          "risk": "coding_not_done_in_cloud_workspace",
          "detection": "ticket.claudeChecks.cloudWorkspaceValidated == false",
          "block": [
            "ready_for_operator_test",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-012",
          "risk": "git_discipline_missing_or_mixed_changes",
          "detection": "ticket.gitDiscipline.noMixedScope == false OR ticket.gitDiscipline.noConflictMarkers == false",
          "block": [
            "ready_for_operator_test",
            "staging_deploy",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-013",
          "risk": "missing_session_bootstrap_or_required_file_read",
          "detection": "ticket.sessionBoot.requiredFilesRead missing required workflow files OR ticket.sessionBoot.bootstrappedBy != claude",
          "block": [
            "ready_for_operator_test",
            "lock_ticket"
          ]
        },
        {
          "id": "CL-014",
          "risk": "production_invariants_not_verified",
          "detection": "any required productionInvariants status != pass OR any productionInvariants status == fail/pending at ready status",
          "block": [
            "ready_for_operator_test",
            "ready_for_lock",
            "lock_ticket",
            "certify_screen"
          ]
        }
      ],
      "operator": [
        {
          "id": "OP-001",
          "risk": "signoff_without_real_staging_test",
          "detection": "ticket.operatorChecks.stagingTestExecuted == false OR ticket.operatorChecks.testedOnRealTarget == false",
          "block": [
            "ready_for_impact_retest",
            "lock_ticket"
          ]
        },
        {
          "id": "OP-002",
          "risk": "passing_ticket_while_blocking_issues_exist",
          "detection": "ticket.operatorChecks.blockingIssueCount > 0",
          "block": [
            "ready_for_impact_retest",
            "ready_for_lock",
            "lock_ticket"
          ]
        },
        {
          "id": "OP-003",
          "risk": "screen_certification_without_full_ticket_lock",
          "detection": "screen.certification.allTicketsLocked == false",
          "block": [
            "certify_screen",
            "enter_freeze"
          ]
        },
        {
          "id": "OP-004",
          "risk": "freeze_approval_without_full_signoff",
          "detection": "freeze.approvals.operatorApproved == false OR freeze.verification.operatorFullSignoff == false",
          "block": [
            "enter_freeze",
            "promote_production"
          ]
        },
        {
          "id": "OP-005",
          "risk": "operator_tests_wrong_deployment_revision",
          "detection": "ticket.operatorChecks.validatedDeploymentRef != ticket.claudeChecks.stagingDeploymentRef",
          "block": [
            "ready_for_impact_retest",
            "ready_for_lock",
            "lock_ticket"
          ]
        },
        {
          "id": "OP-006",
          "risk": "operator_signoff_without_dependency_acknowledgement",
          "detection": "ticket.dependencyDisclosure.operatorAcknowledged == false",
          "block": [
            "ready_for_lock",
            "lock_ticket"
          ]
        }
      ]
    },
    "screenCertificationRules": {
      "required": [
        "all_screen_tickets_locked",
        "impact_retest_passed",
        "operator_screen_signoff",
        "staging_parity_proof"
      ],
      "reopenOnAnyNewIssue": true
    },
    "freezeRules": {
      "requiresAllScreensCertified": true,
      "requiresNoActiveTickets": true,
      "requiresFreezeManifestLock": true,
      "requiresImageDigestsAndRevisions": true,
      "requiresDbMigrationLock": true
    },
    "deploymentRules": {
      "allowedStagingModes": [
        "LIVE_FIX",
        "FREEZE_CANDIDATE",
        "FREEZE_READY"
      ],
      "productionModeRequires": "FREEZE_READY",
      "claudeMaxBoundary": "staging",
      "productionPromotionActor": "operator",
      "requireDistinctStagingAndProductionTargets": true,
      "requireImmutableImageDigest": true,
      "requirePinnedSecretVersions": true,
      "failClosedIfStagingVerificationUnavailable": true,
      "requireMigrationSafetyForDbChanges": true
    },
    "deploymentBatchPolicy": {
      "baseScreensPerBatch": 3,
      "hardMaxTicketsPerBatch": 25,
      "maxScreensWhenBackendOrSharedApiChanged": 2,
      "maxScreensWhenDbOrMigrationOrUrlMapChanged": 1,
      "maxScreensWhenPosAndBackendChangedTogether": 1,
      "requireBatchManifestForStagingDeploy": true
    },
    "sessionRules": {
      "requireSessionIdForTransitions": true,
      "sessionIdEnvVar": "WORKFLOW_SESSION_ID"
    },
    "gitDiscipline": {
      "requireCleanWorktreeBeforeStagingDeploy": true,
      "blockDetachedHead": true,
      "blockConflictMarkers": true,
      "allowDirtyStagingBatchManifest": true,
      "allowedDirtyFilesBeforeStagingDeploy": [
        "workflow/state/staging_batch.json"
      ]
    },
    "monitoringRules": {
      "enableTicketMonitor": true,
      "defaultIntervalSeconds": 30,
      "maxErrorLinesPerTicket": 8,
      "reportOutputFile": "workflow/state/live_monitor_report.json"
    }
  },
  "paths": {
    "ticketsDir": "workflow/tickets",
    "screensDir": "workflow/screens",
    "freezeManifestFile": "workflow/state/freeze_manifest.json",
    "stagingBatchFile": "workflow/state/staging_batch.json"
