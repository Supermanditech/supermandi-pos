      "principles": [
        {
          "id": "ETH-001",
          "title": "No Partial Completion Claims",
          "rule": "No ticket can move to enforced statuses unless all required layers are pass with complete evidence."
        },
        {
          "id": "ETH-002",
          "title": "Zero Regression Bar",
          "rule": "Regression checklist, operator checks, and staging parity must remain green before claiming production-grade quality."
        },
        {
          "id": "ETH-003",
          "title": "Truthful Progress Signaling",
          "rule": "Sub-100% progress language is disallowed in enforced statuses."
        },
        {
          "id": "ETH-004",
          "title": "Evidence Over Assumption",
          "rule": "Production-grade claims must be backed by runtime evidence from GCP staging."
        },
        {
          "id": "ETH-005",
          "title": "No Hidden Blockers",
          "rule": "Pending readiness items and blocking operator issues must be zero in enforced statuses."
        }
      ]
