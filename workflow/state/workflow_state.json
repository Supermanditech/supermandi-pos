  "rules": {
    "ticketStateMachine": {
      "transitions": [
        {
          "from": "todo",
          "to": "in_progress",
          "actor": "claude"
        },
        {
          "from": "in_progress",
          "to": "ready_for_operator_test",
          "actor": "claude"
        },
        {
          "from": "ready_for_operator_test",
          "to": "operator_failed",
          "actor": "operator"
        },
        {
          "from": "ready_for_operator_test",
          "to": "ready_for_impact_retest",
          "actor": "operator"
        },
        {
          "from": "operator_failed",
          "to": "in_progress",
          "actor": "claude"
        },
        {
          "from": "ready_for_impact_retest",
          "to": "impact_retest_failed",
