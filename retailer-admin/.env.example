# Backend API (must point to API Gateway)
VITE_API_BASE_URL=http://localhost:3000

# Firebase Configuration (required for OTP authentication)
# Get these values from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA (optional, for Firebase App Check)
# VITE_RECAPTCHA_SITE_KEY=

# Build metadata (set by CI — do not set locally)
# VITE_GIT_SHA=
# VITE_BUILD_TIME=

# File upload limits (MB, optional — defaults to 5)
# VITE_MAX_CSV_IMPORT_SIZE_MB=5
# VITE_MAX_PRODUCT_IMAGE_SIZE_MB=5
# VITE_MAX_DOCUMENT_SIZE_MB=5

# Demo Mode (development only - NEVER set in production)
# Set to 'true' to enable demo mode toggle (bypasses Firebase)
# VITE_DEMO_MODE=true
