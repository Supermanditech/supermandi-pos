# Retailer Admin Portal - Production Environment Template
# GO-LIVE-101: NEVER commit actual values. Copy to .env.production and fill in.

# API Gateway URL (VM production endpoint)
VITE_API_BASE_URL=https://your-production-domain.com

# Firebase Configuration (from Firebase Console > Project Settings)
# NEVER commit actual keys - get from team lead or secrets manager
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
