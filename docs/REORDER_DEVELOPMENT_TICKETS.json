      "acceptanceCriteria": [
        "GET /suppliers - List linked suppliers",
        "POST /suppliers/link - Link supplier (with dedup by GSTIN)",
        "PUT /suppliers/{id} - Update supplier settings",
        "DELETE /suppliers/{id}/unlink - Unlink from store",
        "GSTIN validation working (regex + checksum)",
        "Unit tests with 80% coverage"
      ],
      "apiEndpoints": [
        {
          "method": "GET",
          "path": "/api/v1/stores/{storeId}/suppliers",
          "description": "List all suppliers linked to store"
        },
        {
          "method": "POST",
          "path": "/api/v1/stores/{storeId}/suppliers/link",
          "description": "Link supplier to store (creates if new, links if exists)"
        },
        {
          "method": "PUT",
          "path": "/api/v1/stores/{storeId}/suppliers/{supplierId}",
          "description": "Update supplier link settings (priority, auto-reorder, etc.)"
        },
        {
          "method": "DELETE",
          "path": "/api/v1/stores/{storeId}/suppliers/{supplierId}/unlink",
          "description": "Unlink supplier from store (doesn't delete supplier)"
        }
      ],
      "technicalNotes": "GSTIN is the primary dedup key. When linking, always check if GSTIN exists first. Use transaction for creating supplier + link atomically."
    },
