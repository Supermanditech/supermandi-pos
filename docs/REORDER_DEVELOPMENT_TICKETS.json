      "description": "Background service that monitors stock levels and creates pending reorders.",
      "acceptanceCriteria": [
        "Cron job runs every hour",
        "Gets all stores with auto-reorder enabled",
        "For each store, checks products against thresholds",
        "Creates pending reorder if stock < threshold",
        "Skips if pending reorder already exists",
        "Finds best supplier based on priority/price/stock",
        "Sends notification to store",
        "Logs all actions for debugging"
      ],
      "cronSchedule": "0 * * * *",
      "algorithm": [
        "1. Get stores where auto_reorder_enabled = true",
        "2. For each store:",
        "   a. Get products where current_stock < threshold",
        "   b. Filter out products with existing pending reorders",
        "   c. For each low-stock product:",
        "      - Get linked suppliers with this product",
        "      - Sort by: priority ASC, price ASC, stock DESC",
        "      - Create pending_reorder with top supplier",
        "3. Send batch notification per store"
      ],
      "technicalNotes": "Use Bull queue for reliable job processing. Process stores in parallel (with concurrency limit). Add circuit breaker for notification service."
    },
