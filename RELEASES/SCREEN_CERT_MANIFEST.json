  "deployGate": {
    "rule": "A deploy candidate requires ALL screens in the target cluster's journeys to be CERT-PASS. No partial deployment of CERT-PENDING screens.",
    "regressionGuardBlockingRule": "Any screen with a knownIssue where regressionGuardStatus=MISSING or regressionGuardStatus=FAIL BLOCKS deploy. No exceptions.",
    "scopeLockViolationRule": "Any screen with a file in scopeLock that has reauditRequired=true BLOCKS deploy until re-audit completes.",
    "currentBlockers": "All screens CERT-PENDING or CERT-IN-PROGRESS. All knownIssues have regressionGuardStatus=MISSING.",
    "nextDeployEligibleWhen": "JOURNEY-02 + JOURNEY-03 + JOURNEY-04 + JOURNEY-05 all CERT-SEALED. All regressionGuardStatus=PASS for C1 screens."
  },

  "operatorFatigueRules": {
    "maxJourneysPerOperatorSession": 4,
    "rule": "Operator tests at most 4 journeys per session. Each journey has a pre-written structured script. Operator follows script exactly and logs pass/fail per step. No freestyle exploration until scripted pass is complete.",
    "structuredScriptRequired": true,
    "structuredScriptFormat": "Each step: precondition + action + expectedOutcome. Operator logs: actualOutcome + PASS|FAIL.",
    "noExplorationBeforeScriptedPass": true,
    "operatorIsLastLineNotFirstLine": "Operator testing confirms what Claude certified. It does not discover basic flow breakage. If operator finds basic breakage, that is a CCC audit failure — fix the audit, not just the code.",
    "runtimeEvidenceRequired": "Operator fills runtimeEvidence[] in JOURNEY_MAP.json for each action tested. Claude verifies evidence completeness before CERT-SEALED.",
    "runtimeEvidenceFormat": {
      "type": "OPERATOR_CONFIRMED | AUTOMATED_TEST | SCREENSHOT | LOG_EXTRACT",
      "step": "ACT-02-NN",
      "result": "PASS | FAIL",
      "actualOutcome": "description of what actually happened",
      "timestamp": "ISO timestamp",
      "notes": ""
    }
  }
