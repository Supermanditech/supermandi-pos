# SuperMandi Supplier Portal — Environment Variables (GCP-STG-0476)
# Copy this file to .env.local and fill in the values.

# ── API ──
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ── Firebase ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── Auth ──
NEXT_PUBLIC_AUTH_COOKIE_NAME=supplier_token

# ── Build metadata (set by CI) ──
NEXT_PUBLIC_BUILD_SHA=dev
NEXT_PUBLIC_BUILD_TIME=
NEXT_PUBLIC_GIT_SHA=

# ── File upload limits (MB) ──
NEXT_PUBLIC_MAX_CSV_UPLOAD_SIZE_MB=5
NEXT_PUBLIC_MAX_PRODUCT_IMAGE_SIZE_MB=5
NEXT_PUBLIC_MAX_KYC_DOCUMENT_SIZE_MB=5
