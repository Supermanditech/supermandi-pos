# Docker Ignore - V3.0.9 compliant
# Files to exclude from Docker build context

# Dependencies
node_modules
**/node_modules

# Build outputs (will be created in container)
dist
**/dist

# TypeScript build cache (causes stale .d.ts issues)
*.tsbuildinfo
**/tsconfig.tsbuildinfo

# Test files
**/*.test.ts
**/*.spec.ts
__tests__/
**/__tests__/
tests/
**/tests/
*.test.*
*.spec.*
coverage/
**/coverage/
e2e-tests/

# Development files
.env
.env.*
!.env.prod.example
*.log
*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git
.gitignore

# Docker
Dockerfile*
docker-compose*.yml
.docker/

# Documentation
*.md
!README.md
docs/

# Planning docs — not needed at runtime
RELEASES/
CLAUDE.md
.claude/

# Screenshots
*.png
*.jpg

# Tooling
scripts/
.github/
.husky/
FIX_LEDGER.json

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
