# GCP-STG-0097: Comprehensive Cloud Run environment variables
# All vars referenced by backend code, categorized by requirement level.
# Set in Cloud Run service config or via Secret Manager references.

# ═══════════════════════════════════════════════════════════════
# REQUIRED — Service will crash or misbehave without these
# ═══════════════════════════════════════════════════════════════

# Database (Cloud SQL via VPC connector)
DB_HOST=/cloudsql/supermandi-backend:asia-south1:supermandi-staging
DB_PORT=5432
DB_NAME=supermandi
# DB_USER and DB_PASSWORD via Secret Manager
DATABASE_URL=postgresql://USER:PASS@/supermandi?host=/cloudsql/...

# Auth
JWT_SECRET=<from Secret Manager: jwt-secret>
# JWT_SECRET_PREVIOUS — for zero-downtime rotation (GCP-STG-0480)
# Rotation procedure:
# 1. Create new secret value in Secret Manager
# 2. Copy current JWT_SECRET value to JWT_SECRET_PREVIOUS
# 3. Update JWT_SECRET to new value
# 4. Deploy — backend tries new secret first, falls back to previous
# 5. After 24h (all old tokens expired), remove JWT_SECRET_PREVIOUS
JWT_SECRET_PREVIOUS=

# SERVICE_TOKEN_SECRET — Inter-service authentication (GCP-STG-0617)
# Used by API Gateway to verify requests from internal services
# Rotation: Quarterly. Update in Secret Manager, then redeploy all services.
# What breaks if wrong: API Gateway rejects backend health checks
SERVICE_TOKEN_SECRET=

# ADMIN_TOKEN — SuperAdmin health endpoint authentication (GCP-STG-0617)
# Used by /api/v1/admin/health/detailed for authenticated health checks
# Rotation: Annually. Simple string comparison (not JWT).
# What breaks if wrong: Detailed health endpoint returns 401
ADMIN_TOKEN=<from Secret Manager: admin-token>
ADMIN_EMAIL_ALLOWLIST=supermanditech@gmail.com

# Redis (Memorystore)
REDIS_URL=redis://MEMORYSTORE_IP:6379

# Email (required for OTP)
EMAIL_FROM=supermanditech@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=supermanditech@gmail.com
SMTP_PASS=<from Secret Manager: smtp-password>

# ═══════════════════════════════════════════════════════════════
# RECOMMENDED — Staging-specific overrides
# ═══════════════════════════════════════════════════════════════

# Rate limiting (10x for staging to avoid test lockouts)
RATE_LIMIT_MULTIPLIER=10

# Node environment
NODE_ENV=production

# GCP Project
GCP_PROJECT_ID=supermandi-backend

# Frontend URLs (for CORS and email links)
FRONTEND_URL=https://staging.supermandi.tech
RETAILER_ADMIN_URL=https://staging.supermandi.tech/retailer
SUPPLIER_PORTAL_URL=https://staging.supermandi.tech/supplier
WEBSITE_URL=https://staging.supermandi.tech

# CORS (comma-separated allowed origins)
# GCP-STG-0603: CORS domain configuration
# STAGING:    https://staging.supermandi.tech,https://www.staging.supermandi.tech
# PRODUCTION: https://supermandi.tech,https://www.supermandi.tech
CORS_ALLOWED_ORIGINS=https://staging.supermandi.tech
ALLOWED_ORIGINS=https://staging.supermandi.tech

# Cookie settings
COOKIE_DOMAIN=staging.supermandi.tech
COOKIE_SECURE=true

# Trust proxy (Cloud Run is behind load balancer)
TRUST_PROXY=true
TRUST_PROXY_HOPS=2

# ═══════════════════════════════════════════════════════════════
# OPTIONAL — Features that gracefully degrade without these
# ═══════════════════════════════════════════════════════════════

# GCS Buckets
GCS_DOCUMENTS_BUCKET=supermandi-pos-documents
GCS_IMAGES_BUCKET=supermandi-pos-images
GCS_CHAT_BUCKET=supermandi-chat
IMAGE_PUBLIC_BASE_URL=https://storage.googleapis.com/supermandi-pos-images

# Firebase (for POS OTP auth)
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=supermandi-backend
# FIREBASE_SERVICE_ACCOUNT_PATH — use default credentials on Cloud Run

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=<from Secret Manager: whatsapp-token>
WHATSAPP_PHONE_NUMBER_ID=<WhatsApp Business phone number ID>
WHATSAPP_VERIFY_TOKEN=<webhook verification token>
WHATSAPP_APP_SECRET=<from Secret Manager: whatsapp-app-secret>

# OpenAI (for voice/AI features)
OPENAI_API_KEY=<from Secret Manager: openai-api-key>
OPENAI_MAX_CONCURRENCY=5
OPENAI_MAX_RETRIES=3

# Resend (alternative email provider)
# RESEND_API_KEY=<from Secret Manager>

# Payment
# RAZORPAY_KEY_ID=<from Secret Manager>
# RAZORPAY_KEY_SECRET=<from Secret Manager>
DEFAULT_UPI_VPA=supermandi@upi

# SuperMandi entity (for invoicing)
SUPERMANDI_ENTITY_NAME=SuperMandi Tech Pvt Ltd
SUPERMANDI_GSTIN=<company GSTIN>
SUPERMANDI_ADDRESS=<company address>
SUPERMANDI_STATE=Maharashtra
SUPERMANDI_UPI_VPA=supermandi@upi
SUPERMANDI_COLLECTION_VPA=supermandi@upi

# INVOICE_SIGNING_KEY — HMAC key for invoice PDF integrity verification
# Used by invoiceService.ts to sign generated invoices
# If not set, invoice signing is skipped (non-blocking)
INVOICE_SIGNING_KEY=

# Barcode lookup
# UPC_DATABASE_API_KEY=<from Secret Manager>
BARCODE_LOOKUP_ENABLED=false

# DB tuning
DB_POOL_MIN=5
# DB_POOL_MAX — max connections per Cloud Run instance (GCP-STG-0365)
# With max-instances=10, total pool = 10 × 10 = 100 connections
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000
DB_SSL=true

# Logging (GCP-STG-0616)
# LOG_LEVEL — runtime log verbosity control
# Values: debug, info, warn, error
# Change to 'debug' for troubleshooting without redeploying
LOG_LEVEL=info
LOG_FORMAT=json

# Error Reporting (GCP-STG-0615)
# Cloud Error Reporting auto-detects errors from structured logs.
# Enable: gcloud services enable clouderrorreporting.googleapis.com
# No app-level config needed — just ensure LOG_FORMAT=json in production.
ERROR_REPORTING_ENABLED=true

# Feature flags
CREDIT_ENABLED=false
SUPPLIER_PAYOUTS_ENABLED=false
EMAIL_DISABLED=false

# SMS — PERMANENTLY DISABLED (Architecture Decision)
# SuperMandi uses WhatsApp (POS OTP) + Firebase Phone Auth (web portals).
# SMS fallback code exists (GCP-STG-0467) but is disabled by design.
# Setting SMS_DISABLED=false requires MSG91/Twilio credentials.
SMS_DISABLED=true
#
# SMS Provider Configuration (when SMS_DISABLED=false)
# Supported providers: MSG91, Twilio
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your_auth_key
# MSG91_SENDER_ID=SUPMND
# MSG91_TEMPLATE_ID=your_template_id
#
# Alternative: Twilio
# SMS_PROVIDER=twilio
# TWILIO_SID=your_sid
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_FROM=+1234567890

# MAX_COMMISSION_PERCENT — max commission SuperMandi takes on sales
MAX_COMMISSION_PERCENT=30

# POS
MIN_APP_VERSION=1.0.0
ENROLLMENT_TTL_MINUTES=60

# GCP-STG-0657: Refund time limit — max days after sale to allow void/refund
REFUND_MAX_DAYS=7

# Build metadata (set by CI)
# GIT_SHA=<auto-set>
# BUILD_TIME=<auto-set>

# ═══════════════════════════════════════════════════════════════
# PII ENCRYPTION AT REST (GCP-STG-0681)
# ═══════════════════════════════════════════════════════════════
# Cloud SQL encrypts ALL data at rest using Google-managed keys (AES-256).
# This covers all PII: phone numbers, GSTIN, bank details, addresses, emails.
# No application-level encryption config is needed — it is automatic.
# For CMEK (Customer-Managed Keys), see: scripts/gcp/verify-encryption.sh
# Verify status: bash scripts/gcp/verify-encryption.sh

# ═══════════════════════════════════════════════════════════════
# AUTO-SET by Cloud Run (do NOT manually set)
# ═══════════════════════════════════════════════════════════════
# PORT=8080           (Cloud Run sets this)
# K_SERVICE=<name>    (Cloud Run sets this)
# K_REVISION=<rev>    (Cloud Run sets this)
