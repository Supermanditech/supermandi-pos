# CR-SVCURL-001: Cloud Run environment variables for inter-service communication
# In Cloud Run, each service gets a unique URL. Set these via Secret Manager or env config.
# All *_SERVICE_URL vars are REQUIRED in production (NODE_ENV=production). Missing = crash.

# Main backend (monolith) — used by api-gateway
ADMIN_SERVICE_URL=https://main-backend-HASH-uc.a.run.app

# Payment service — used by api-gateway
PAYMENT_SERVICE_URL=https://payment-service-HASH-uc.a.run.app

# Inventory service — used by order-service, platform-service
INVENTORY_SERVICE_URL=https://inventory-service-HASH-uc.a.run.app

# Database (Cloud SQL via VPC connector)
DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE
DB_PORT=5432
DB_NAME=supermandi
DB_USER=supermandi
DB_PASSWORD=<from Secret Manager>

# Or use DATABASE_URL for migration script
DATABASE_URL=postgresql://supermandi:PASSWORD@/supermandi?host=/cloudsql/PROJECT:REGION:INSTANCE

# Redis (Memorystore via VPC connector)
REDIS_URL=redis://MEMORYSTORE_IP:6379

# Auth / Secrets
JWT_SECRET=<from Secret Manager>
ADMIN_TOKEN=<from Secret Manager>
OPENAI_API_KEY=<from Secret Manager>
ANTHROPIC_API_KEY=<from Secret Manager>

# Cloud Run sets PORT automatically
# PORT=8080
