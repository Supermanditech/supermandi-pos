{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "typeRoots": ["../node_modules/@types"],
    "types": ["jest", "node"],
    "baseUrl": "..",
    "paths": {
      "@supermandi/common": ["packages/common/src"],
      "@supermandi/common/*": ["packages/common/src/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
