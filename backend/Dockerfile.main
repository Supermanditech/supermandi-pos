# Main Backend Dockerfile - POS Routes
# This serves the legacy POS API routes (/api/v1/pos/*)

FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.11.0 --activate

# Copy workspace files
COPY pnpm-workspace.yaml ./
COPY package.json pnpm-lock.yaml ./
COPY packages/common/package.json ./packages/common/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/common ./packages/common
COPY src ./src
COPY tsconfig.base.json ./
COPY tsconfig.main.json ./
COPY tsconfig.json ./

# Build common package first
WORKDIR /app/packages/common
RUN pnpm run build

# Build main backend
WORKDIR /app
RUN pnpm exec tsc -p tsconfig.main.json

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@8.11.0 --activate

COPY pnpm-workspace.yaml ./
COPY package.json pnpm-lock.yaml ./
COPY packages/common/package.json ./packages/common/

RUN pnpm install --frozen-lockfile --prod

# Copy built artifacts
COPY --from=builder /app/packages/common/dist ./packages/common/dist
COPY --from=builder /app/dist ./dist

# Create workspace link for @supermandi/common
RUN mkdir -p node_modules/@supermandi && \
    ln -s /app/packages/common node_modules/@supermandi/common

# Copy migrations and entrypoint for production migration runner
COPY migrations ./migrations
COPY scripts/migrate-prod.js ./scripts/migrate-prod.js
COPY scripts/docker-entrypoint.sh ./scripts/docker-entrypoint.sh
RUN chmod +x ./scripts/docker-entrypoint.sh

# ISSUE-MICRO-037: Run as non-root user for security
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
RUN chown -R nodejs:nodejs /app
USER nodejs

WORKDIR /app

ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ENV NODE_ENV=production
ENV PORT=3010
ENV GIT_SHA=$GIT_SHA
ENV BUILD_TIME=$BUILD_TIME

EXPOSE 3010

# Entrypoint: runs migrations then starts server
CMD ["./scripts/docker-entrypoint.sh"]
