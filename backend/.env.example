# ===========================================
# SuperMandi Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Node Environment
NODE_ENV=development

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=supermandi
DATABASE_USER=supermandi
DATABASE_PASSWORD=supermandi_dev_password
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# SCALE-D2: Connection pool tuning for 10K user scale
# DB_POOL_MIN: warm connections kept alive during idle periods (default: 5)
# DB_POOL_MAX: max concurrent connections per instance (default: 25)
# Cloud SQL basic tier = 100 connections; 25+10(common)=35 per instance, safe for 3 instances
DB_POOL_MIN=5
DB_POOL_MAX=25

# Full connection string (alternative)
DATABASE_URL=postgresql://supermandi:supermandi_dev_password@localhost:5432/supermandi
TEST_DATABASE_URL=postgresql://supermandi:supermandi_dev_password@localhost:5432/supermandi_test

# ===========================================
# Redis Configuration (Bull Queues)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Full connection string (alternative)
REDIS_URL=redis://localhost:6379/0

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=supermandi

# ===========================================
# Service Ports
# ===========================================
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
SUPPLIER_SERVICE_PORT=3002
CATALOG_SERVICE_PORT=3003
INVENTORY_SERVICE_PORT=3004
ORDER_SERVICE_PORT=3005
REORDER_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
PLATFORM_SERVICE_PORT=3008

# ===========================================
# Service URLs (for inter-service communication)
# ===========================================
AUTH_SERVICE_URL=http://localhost:3001
SUPPLIER_SERVICE_URL=http://localhost:3002
CATALOG_SERVICE_URL=http://localhost:3003
INVENTORY_SERVICE_URL=http://localhost:3004
ORDER_SERVICE_URL=http://localhost:3005
REORDER_SERVICE_URL=http://localhost:3006
PLATFORM_SERVICE_URL=http://localhost:3008

# ===========================================
# API Gateway Configuration
# ===========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ===========================================
# Feature Flags (defaults)
# ===========================================
FEATURE_REORDER_ENABLED=true
FEATURE_BUY_TAB_ENABLED=true
FEATURE_GRN_ENABLED=true

# ===========================================
# Cron Jobs
# ===========================================
STOCK_MONITOR_CRON=0 */15 * * * *
OUTBOX_WORKER_POLL_INTERVAL_MS=1000

# ===========================================
# Firebase Configuration (Retailer OTP Auth)
# GL-CRIT-0019: NEVER commit actual Firebase credentials
# Use service account JSON file mounted at runtime
# ===========================================
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account JSON (mounted in production)
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/supermandi/firebase-service-account.json

# ===========================================
# OpenAI Configuration (AI + Voice Services)
# GO-LIVE: Replaced Claude/Anthropic with OpenAI
# GL-CRIT-0051: NEVER commit actual API keys
# ===========================================
# API key (server-side only, never expose to frontend)
OPENAI_API_KEY=your-openai-api-key-here

# Chat completion model (for admin AI and intent parsing)
OPENAI_MODEL_CHAT=gpt-4o-mini
# Speech-to-text model (for voice orders)
OPENAI_MODEL_STT=whisper-1

# Token limits and safety controls
OPENAI_MAX_TOKENS=512
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_CONCURRENCY=5
OPENAI_MAX_RETRIES=3

# Voice-specific settings
VOICE_MAX_FILE_SIZE_MB=10

# ===========================================
# Onboarding Configuration (RO-009)
# Required for registration notifications
# ===========================================
# SMS: set provider or disable explicitly
SMS_PROVIDER=disabled
SMS_DISABLED=true
# Portal + POS URLs for onboarding notifications
PORTAL_BASE_URL=http://localhost:8081
POS_APP_DOWNLOAD_URL=https://supermandi.tech/pos

# ===========================================
# Email Service Configuration (GO-LIVE)
# GL-WF-034: Email verification for suppliers
# ===========================================
# Provider: 'resend' (recommended), 'smtp', or 'disabled'
EMAIL_PROVIDER=disabled
# From address for verification emails
EMAIL_FROM=SuperMandi <noreply@supermandi.tech>

# Resend Configuration (if EMAIL_PROVIDER=resend)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# SMTP Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# ===========================================
# SuperMandi Entity Details (Invoicing — GAP-5)
# Used as buyer/seller on invoices
# ===========================================
SUPERMANDI_ENTITY_NAME=SUPERMANDI TECH PRIVATE LIMITED
SUPERMANDI_GSTIN=08ABRCS8282R1ZY
SUPERMANDI_ADDRESS=166/1, Bhandu Khurd, Jodhpur, Rajasthan - 342014
SUPERMANDI_STATE=Rajasthan

# ===========================================
# Security Configuration
# GL-CRIT-0006: Admin token for internal service auth
# GL-CRIT-0026: HTTPS enforcement
# ===========================================
ADMIN_TOKEN=generate-a-secure-random-token
ADMIN_EMAIL_ALLOWLIST=admin@supermandi.tech
# Set to 'true' in production to enforce HTTPS
FORCE_HTTPS=false
# Trusted proxy count for X-Forwarded-Proto header
TRUST_PROXY=1

# ===========================================
# CORS Configuration
# GCP-STG-0476: Explicit allowed origins
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4001,http://localhost:5174

# ===========================================
# Payment Gateway Configuration
# GL-CRIT: NEVER commit actual keys
# ===========================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=
SUPERMANDI_UPI_VPA=
DEFAULT_UPI_VPA=
SUPERMANDI_COLLECTION_VPA=supermandi@upi
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PINE_LABS_SECRET=
PAYOUT_PROCESS_API_KEY=

# ===========================================
# WhatsApp Integration
# ===========================================
WHATSAPP_APP_SECRET=

# ===========================================
# GCS Storage Buckets
# ===========================================
GCS_IMAGES_BUCKET=supermandi-pos-images
GCS_DOCUMENTS_BUCKET=supermandi-pos-documents
GCS_CHAT_BUCKET=supermandi-chat
IMAGE_PUBLIC_BASE_URL=/uploads

# ===========================================
# Misc Tuning
# ===========================================
RATE_LIMIT_MULTIPLIER=1
ENROLLMENT_TTL_MINUTES=1440
STOCK_CACHE_TTL_MS=300000
ALLOW_DEMO_MULTIUSE=false
SERVICE_NAME=main-backend
