# Local Development Environment (DO NOT COMMIT .env.local)
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will not be committed.
#
# These env vars are loaded by tools/dev/redmi.ps1 when using -TestStore flag.

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL (defaults to production if not set)
# EXPO_PUBLIC_API_URL=http://34.14.220.171:3000

# POS API URL (enrollment service) - optional, derived from API_URL if not set
# EXPO_PUBLIC_POS_API_URL=http://34.14.220.171:3009

# =============================================================================
# Test Store Credentials (DEV only)
# =============================================================================
# These are used by the "Quick Login" dev shortcut in EnrollDeviceScreen.
# Get these from your TEST STORE setup - DO NOT use production credentials!

# Test store phone number (10 digits)
EXPO_PUBLIC_TEST_PHONE=

# Test store PIN (4-6 digits)
EXPO_PUBLIC_TEST_PIN=

# Test store name (optional, for display)
EXPO_PUBLIC_TEST_STORE_NAME=TEST STORE

# =============================================================================
# Expo Authentication
# =============================================================================
# Required for Expo Go. Get from: https://expo.dev/settings/access-tokens
# Can also be set in PowerShell: $env:EXPO_TOKEN = "your-token"

# EXPO_TOKEN=
