# Frontend (Expo) — GCP-STG-0476
#
# Required.
# The app reads API base URL ONLY from `process.env.EXPO_PUBLIC_API_URL`.
# If missing, it fails fast at startup (see [`API_BASE_URL`](src/config/api.ts:1)).
#
# Dev/Test APK on LAN (this PC + Redmi 13C on same Wi-Fi):
EXPO_PUBLIC_API_URL=http://192.168.31.66:3001

# Firebase (retained for future push notifications / analytics — POS uses backend OTP)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Build metadata (set by CI / build scripts — do not set locally)
# EXPO_PUBLIC_GIT_SHA=
# EXPO_PUBLIC_GIT_BRANCH=
# EXPO_PUBLIC_BUILD_TIME=
# EXPO_PUBLIC_WORKTREE_FINGERPRINT=

# Test / QA (development only — NEVER set in production)
# EXPO_PUBLIC_TEST_PHONE=
# EXPO_PUBLIC_TEST_PIN=
# EXPO_PUBLIC_TEST_STORE_NAME=TEST STORE
# EXPO_PUBLIC_QA_ENABLED=false

# iOS App Store URL (REQ.AUDIT.W4.POS.APPSTORE-URL-MISSING.001)
# Set this once the iOS app is live on the App Store.
# Format: https://apps.apple.com/app/id<APP_ID>
# When empty or unset, the ForceUpdate screen falls back to the Play Store link.
# EXPO_PUBLIC_APP_STORE_URL=
